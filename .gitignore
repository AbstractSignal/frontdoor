# Built artifacts of the app, ignored in the repo dir (this file travels with
# the app so the repo's root .gitignore stays about the repo).
#
# `dist` matters twice over: it is derived (bin/dashboard-build.sh rebuilds it),
# AND the built bundle has the HA access token inlined in it (Vite inlines
# import.meta.env.VITE_*), so committing it would put a live token in git.
# `.env` is the build input - same reason, same key. `dist` is then pushed to the
# 'services' box by the infra repo's playbooks/services-lxc.yml (see README.md).
dist
.env
.env.*
!.env.example

# package-lock.json carries resolved registry URLs and is regenerated by `npm install`;
# it is not a fact about the app, so it is not tracked (deleted 2026-10-25, when this
# tree lived in the infra repo).
package-lock.json

# `undefined/` guards against a Chrome harness opening its profile HERE (its profile path
# was the JS value `undefined`); the directory is not a fact about the app.
undefined/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
